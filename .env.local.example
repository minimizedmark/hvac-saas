# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_FOUNDING_PRICE_ID=your_founding_price_id
STRIPE_MONTHLY_PRICE_ID=your_monthly_price_id
STRIPE_ANNUAL_PRICE_ID=your_annual_price_id

# Resend (for emails)
RESEND_API_KEY=your_resend_api_key

# AI Providers (optional - system works with deterministic logic only)
GROK_API_KEY=your_grok_api_key
HF_API_KEY=your_huggingface_api_key
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Agent Configuration
PROVIDER_ORDER=["deterministic","grok","hf","openai"]
AUTO_EXEC_THRESHOLD=0.95
SUGGEST_THRESHOLD=0.75
MONTHLY_MODEL_BUDGET_USD=100.00
REDACT_PII=true

# External Services (optional)
OSRM_URL=http://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Application
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
